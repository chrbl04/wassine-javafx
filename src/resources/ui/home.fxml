<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ui.HomeController"
            fx:id="root">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 14; -fx-background-color: rgba(255,255,255,0.08);">
            <TextField fx:id="searchField"
                       promptText="Search services..."
                       HBox.hgrow="ALWAYS"
                       style="-fx-background-radius: 10; -fx-padding: 10 12;"/>

            <ComboBox fx:id="sortCombo" prefWidth="200" />

            <!-- Filters dropdown -->
            <MenuButton fx:id="filtersBtn" text="Filters" />

            <Region HBox.hgrow="ALWAYS"/>

            <!-- Account dropdown (icon) -->
            <MenuButton fx:id="accountBtn" style="-fx-background-color: transparent;">
                <graphic>
                    <ImageView fitWidth="28" fitHeight="28" preserveRatio="true">
                        <image>
                            <Image url="@/resources/images/system/icons/account.png"/>
                        </image>
                    </ImageView>
                </graphic>
            </MenuButton>

        </HBox>
    </top>

    <!-- CENTER -->
    <center>
        <VBox spacing="12" style="-fx-padding: 14;">
            <!-- Categories -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ToggleButton fx:id="catAll" text="All" selected="true" />
                <ToggleButton fx:id="catDocuments" text="Documents" />
                <ToggleButton fx:id="catElectronics" text="Electronics" />
                <ToggleButton fx:id="catClothes" text="Clothes" />
                <ToggleButton fx:id="catOthers" text="Others" />
            </HBox>

            <!-- Table -->
            <TableView fx:id="servicesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colImage" text="" prefWidth="90"/>
                    <TableColumn fx:id="colTitle" text="Title" prefWidth="220"/>
                    <TableColumn fx:id="colRoute" text="Route" prefWidth="260"/>
                    <TableColumn fx:id="colCategory" text="Category" prefWidth="120"/>
                    <TableColumn fx:id="colWeight" text="Weight (kg)" prefWidth="110"/>
                    <TableColumn fx:id="colPrice" text="Offer Price" prefWidth="120"/>
                    <TableColumn fx:id="colArrival" text="Delivery Deadline" prefWidth="160"/>
                    <TableColumn fx:id="colPosted" text="Posted" prefWidth="140"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>
