<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/24"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ui.ServiceDetailsController"
      spacing="14"
      style="-fx-padding: 18; -fx-background-color: #ffffff;">

    <Label fx:id="titleLabel"
           text="Service Title"
           style="-fx-font-size: 20; -fx-font-weight: bold;"/>

    <HBox spacing="16">
        <VBox spacing="6">
            <Label text="Category:" style="-fx-font-weight: bold;"/>
            <Label fx:id="categoryLabel" text="-" />
        </VBox>

        <VBox spacing="6">
            <Label text="Offer Price:" style="-fx-font-weight: bold;"/>
            <Label fx:id="priceLabel" text="-" />
        </VBox>

        <VBox spacing="6">
            <Label text="Weight (kg):" style="-fx-font-weight: bold;"/>
            <Label fx:id="weightLabel" text="-" />
        </VBox>
    </HBox>

    <Separator/>

    <VBox spacing="6">
        <Label text="Pickup Address:" style="-fx-font-weight: bold;"/>
        <Label fx:id="pickupLabel" text="-" wrapText="true"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Dropoff Address:" style="-fx-font-weight: bold;"/>
        <Label fx:id="dropoffLabel" text="-" wrapText="true"/>
    </VBox>

    <Separator/>

    <HBox spacing="16">
        <VBox spacing="6">
            <Label text="Date Posted:" style="-fx-font-weight: bold;"/>
            <Label fx:id="postedLabel" text="-" />
        </VBox>

        <VBox spacing="6">
            <Label text="Expected Delivery:" style="-fx-font-weight: bold;"/>
            <Label fx:id="expectedLabel" text="-" />
        </VBox>
    </HBox>

    <Separator/>

    <VBox spacing="6">
        <Label text="Description:" style="-fx-font-weight: bold;"/>
        <Label fx:id="descriptionLabel" text="-" wrapText="true"/>
    </VBox>

</VBox>
